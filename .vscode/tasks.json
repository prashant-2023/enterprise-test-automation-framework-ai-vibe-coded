{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run TestNG suite",
            "type": "shell",
            "command": "mvn",
            "args": [
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
