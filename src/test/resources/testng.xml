<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EnterpriseAutomationSuite" parallel="tests" thread-count="3" data-provider-thread-count="2">

    <test name="Chrome Tests" enabled="true">
    <parameter name = "browser" value = "chrome"/>
        <classes>
        <class name="com.automation.framework.tests.LoginTest"/>
           <class name="com.automation.framework.tests.CreateContactTest"/>
           <class name="com.automation.framework.tests.CreateCompanyTest"/>
           <!-- <class name="com.automation.framework.tests.CreateTaskTest"/> -->
        </classes>
    </test>
    
    <test name="Firefox Tests" enabled="true">
    <parameter name = "browser" value = "firefox"/>
        <classes>
        <class name="com.automation.framework.tests.DeleteContactTest"/>
        <class name="com.automation.framework.tests.DeleteCompanyTest"/>
        <class name="com.automation.framework.tests.CreateDealTest"/>
        <class name="com.automation.framework.tests.DeleteDealTest"/>
        </classes>
    </test>


   
